# addisvipgirls.com — copy to .env (do not commit .env)

BRAND=vip
# Public static site (staging: astro.* — production cutover: apex domain)
SITE_URL=https://astro.addisvipgirls.com

# Phone testing on same Wi‑Fi (optional — auto-detected if omitted)
# DEV_LAN_HOST=192.168.1.86

# WordPress CMS (always the cms subdomain in production)
WP_URL=https://cms.addisvipgirls.com
WP_TOKEN=change-me
# Local only — omit or set 0 on production build agents.
WP_INSECURE=1
WP_UPLOADS_DIR=C:\Users\Get\Local Sites\1\app\public\wp-content\uploads

# cPanel server only — copy dist/ to live site after each rebuild
# ADDIS_PUBLIC_HTML=/home/addisvhi/public_html

# Center watermark on synced escort photos (Option A; default when BRAND=vip)
# WATERMARK=1
WATERMARK_OPACITY=0.45
# Re-apply on files already in sites/.../uploads/
# WATERMARK_FORCE=1
#
# If UPDATE-SITE fails on Sharp (win32-x64): from astro/, run
#   npm install --include=optional sharp @img/sharp-win32-x64@0.34.5
# Close this batch / other Node first if EPERM on libvips DLLs.

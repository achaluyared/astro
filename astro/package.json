{
    "name": "astro",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev --host",
        "build": "astro build",
        "preview": "astro preview --host",
        "astro": "astro",
        "fetch": "node --env-file=.env scripts/fetch-data.mjs",
        "images": "node --env-file=.env scripts/sync-images.mjs",
        "sync": "npm run fetch && npm run images",
        "prepare:site": "node scripts/prepare-site-data.mjs",
        "serve": "node scripts/serve.mjs",
        "check": "astro check"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.6",
        "@types/node": "^22.10.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@fontsource/cormorant-garamond": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.3.8",
        "glightbox": "^3.3.1",
        "lucide": "^1.55.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.3.3"
    },
    "optionalDependencies": {
        "@img/sharp-win32-x64": "^0.34.5"
    },
    "allowScripts": {
        "sharp@0.35.5": true,
        "sharp@0.34.5": true
    }
}

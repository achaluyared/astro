# One .env per brand / WordPress install. Do not commit .env.
#
# BRAND=massage  → massageinaddisababa.com (spa palette, massage home layout)
# BRAND=vip      → addisvipgirls.com (gold palette, VIP home layout)
#
# Examples:
#   addisvipgirls.com        → BRAND=vip SITE_URL=https://addisvipgirls.com
#   massageinaddisababa.com  → BRAND=massage SITE_URL=https://massageinaddisababa.com
#   addisgirls.com             → SITE_URL=https://addisgirls.com
#
BRAND=massage
# WordPress (CMS) base URL, no trailing slash
WP_URL=https://cms.example.com
# Must equal ADDIS_HEADLESS_TOKEN in that site's wp-config.php
WP_TOKEN=change-me
# Local dev only (LocalWP self-signed certificate)
WP_INSECURE=0
# Absolute path to that WordPress install's wp-content/uploads
WP_UPLOADS_DIR=C:\path\to\wp-content\uploads
# Public site URL at build time (canonicals, sitemap, og:url)
SITE_URL=https://www.example.com

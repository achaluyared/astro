---
/** Lower home SEO blocks (after profile grids). Hero lives in HomeHero.astro for this brand. */
---

<div class="home-seo">
  <section class="home-split" aria-labelledby="home-find">
    <div class="home-split-copy">
      <h2 id="home-find">Find Your Perfect Massage Today</h2>
      <p class="lead"><strong>Refine your search with our advanced filters to match your ideal provider:</strong></p>
      <p class="lead">
        Browse authentic photos, read verified reviews, and connect directly with Addis Ababa's most trusted massage
        professionals—all within a secure, discreet platform.
      </p>
      <div class="home-split-actions">
        <a class="btn primary" href="/search/">Start Search</a>
      </div>
    </div>
    <div class="home-steps">
      <div class="home-step">
        <span class="home-step-num">01</span>
        <div>
          <h3>Service Type</h3>
          <p>Swedish, deep tissue, body-to-body, tantric, and more</p>
        </div>
      </div>
      <div class="home-step">
        <span class="home-step-num">02</span>
        <div>
          <h3>Location</h3>
          <p>Bole, Kazanchis, CMC, and all key Addis neighborhoods</p>
        </div>
      </div>
      <div class="home-step">
        <span class="home-step-num">03</span>
        <div>
          <h3>Preferences</h3>
          <p>Incall, outcall, availability, and language</p>
        </div>
      </div>
    </div>
  </section>
</div>

<div class="home-seo">
  <section class="home-split stack-visual-first" aria-labelledby="home-why">
    <div class="home-split-copy">
      <h2 id="home-why">Why Choose Verified Massage Providers?</h2>
      <p class="lead"><strong>Independent professionals offer clear advantages for clients who value discretion</strong></p>
      <ul class="home-why-list">
        <li><strong>Direct booking:</strong> Speak with your therapist without agency delays</li>
        <li><strong>Discretion:</strong> Private communication and confidential arrangements</li>
        <li><strong>Verified profiles:</strong> Authentic photos and transparent service lists</li>
        <li><strong>Flexible options:</strong> Incall, outcall, and varied massage styles</li>
      </ul>
      <p class="lead">
        Our directory connects you with massage girls in Addis Ababa who prioritize professionalism, hygiene, and your
        comfort.
      </p>
      <div class="home-split-actions">
        <a class="btn primary" href="/search/">Start Search</a>
      </div>
    </div>
    <div class="home-split-visual" aria-hidden="true">
      <div class="visual-panel tall"></div>
    </div>
  </section>
</div>

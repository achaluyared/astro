---
/** Inline Lucide-style SVGs (no JS framework). Paths from lucide icons — MIT. */
interface Props {
  name: 'menu' | 'chevron-left' | 'chevron-right' | 'x';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  menu: '<line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line>',
  'chevron-left': '<path d="m15 18-6-6 6-6"></path>',
  'chevron-right': '<path d="m9 18 6-6-6-6"></path>',
  x: '<path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['lucide', className]}
  aria-hidden="true"
  set:html={paths[name]}
/>

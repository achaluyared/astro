---
import { brand } from '../brand';

interface Props {
  href?: string;
}
const { href = '/' } = Astro.props;
const { logo } = brand;
---

<a class="brand" href={href}>
  <svg class="brand-mark" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <circle cx="16" cy="16" r="14.5" fill="var(--panel-2, #171412)" stroke="var(--gold, #d4a574)" stroke-width="1.25" />
    <path
      fill="var(--gold-2, #ecd0b0)"
      d="M16 7.5 21.2 22h-2.35l-1.05-3.35h-3.6L13.15 22h-2.35L16 7.5Zm0 6.85-1.35 4.3h2.7L16 14.35Z"
    />
  </svg>
  <span class="brand-wordmark" aria-hidden="true">
    <span class="brand-rest">{logo.before}</span><span class="brand-vip">{logo.accent}</span>{logo.after && <span class="brand-rest">{logo.after}</span>}
  </span>
  <span class="sr-only">{brand.siteName}</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex: 1 1 auto;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }
  .brand:hover { text-decoration: none; filter: brightness(1.06); }
  .brand-mark {
    display: none;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
  }
  @media (min-width: 768px) {
    .brand-mark { display: block; }
    .brand { flex: 0 1 auto; }
  }
  .brand-wordmark {
    font-weight: 800;
    font-size: clamp(1.05rem, 4.2vw, 1.35rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    white-space: nowrap;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  @media (min-width: 768px) {
    .brand-wordmark {
      font-family: Georgia, 'Times New Roman', serif;
      font-weight: 700;
      font-size: 1.28rem;
      letter-spacing: -0.02em;
    }
  }
  .brand-rest { color: var(--text, #f2ebe6); }
  .brand-vip { color: var(--brand-gold, #e8c4a0); }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

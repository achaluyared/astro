---
import TermArchive from '../../components/TermArchive.astro';
import { termsWithProfiles } from '../../lib/data';

export function getStaticPaths() {
  return termsWithProfiles('features').map((term) => ({ params: { slug: term.slug }, props: { term } }));
}
const { term } = Astro.props;
---

<TermArchive tax="features" term={term} />

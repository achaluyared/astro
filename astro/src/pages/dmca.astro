---
import Base from '../layouts/Base.astro';
import { brand } from '../brand';
import { pageTitle, breadcrumbLd } from '../lib/seo';

const path = '/dmca/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'DMCA & takedown', path },
];
const email = brand.contact.email;
const description = `Report copyright or impersonation on ${brand.siteName}. DMCA and abuse takedown requests — response within 48 hours.`;
---

<Base title={pageTitle('DMCA & takedown')} description={description} path={path} jsonLd={[breadcrumbLd(Astro.site!, crumbs)]}>
  <h1>DMCA &amp; takedown policy</h1>
  <div class="prose">
    <p>
      {brand.siteName} respects intellectual property and the privacy of individuals pictured in listings. If you believe
      content on this site infringes your copyright, depicts you without consent, or violates our terms, submit a notice
      using the details below.
    </p>

    <h2>What to include</h2>
    <ul>
      <li>Your full name and contact email</li>
      <li>The exact profile URL(s) on our site</li>
      <li>For copyright: identification of the copyrighted work and the material you claim is infringing</li>
      <li>For impersonation / non-consensual imagery: a clear statement that you are the person depicted or their authorized agent</li>
      <li>A statement that you believe in good faith that use of the material is not authorized</li>
      <li>A statement, under penalty of perjury, that the information in your notice is accurate</li>
    </ul>

    <h2>How to send a notice</h2>
    <p>
      Email <a href={`mailto:${email}?subject=DMCA%20%2F%20takedown%20request`}>{email}</a> with the subject line
      <strong>DMCA / takedown request</strong>. You may also use our <a href="/contact/">contact page</a> and choose
      “Report a listing.”
    </p>

    <h2>Our response</h2>
    <p>
      We review valid notices promptly and typically respond within <strong>48 hours</strong>. We may remove or disable
      access to disputed content while we investigate. Repeat infringers may have listing privileges revoked.
    </p>

    <h2>Counter-notification</h2>
    <p>
      If your listing was removed and you believe the removal was mistaken, reply to our notice email with evidence that
      you have rights to publish the content (e.g. model release, ownership, or corrected identification).
    </p>

    <p class="muted">
      This page is provided for informational purposes and does not constitute legal advice. Consult qualified counsel for
      your jurisdiction.
    </p>
  </div>
</Base>
